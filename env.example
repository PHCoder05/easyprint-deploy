# Copy to .env next to docker-compose.yml. Do not commit the copy.
# Private GHCR packages need: docker login ghcr.io
# Temporary LAN values below boot the stack. Replace every secret before anyone else uses the host.

EASYPRINT_IMAGE_PREFIX=ghcr.io/phcoder05
# Stable releases replace this with the image tag (v1.4.2). latest is the newest stable tag.
EASYPRINT_IMAGE_TAG=latest

# LAN address of this machine. Browsers and phones use it.
PUBLIC_HOST=10.0.0.208

API_PORT=8080
ADMIN_PORT=8081
MOBILE_PORT=8082
KEYCLOAK_PORT=8180
MINIO_PORT=9000

APP_ENV=development
LOG_LEVEL=info
POSTGRES_USER=easyprint
POSTGRES_PASSWORD=easyprint
POSTGRES_DB=easyprint
KEYCLOAK_DB_NAME=keycloak
MINIO_ROOT_USER=easyprint
MINIO_ROOT_PASSWORD=easyprint
MINIO_BUCKET=easyprint
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

JWT_SECRET=local-dev-only-change-me-not-for-production
PII_SECRET=local-dev-pii-secret-at-least-32-chars!!
PUBLIC_ORG_ID=11111111-1111-4111-8111-111111111111
OTP_SMS_WEBHOOK_URL=http://127.0.0.1:9/otp-stub
RAZORPAY_KEY_ID=rzp_test_localonly
RAZORPAY_KEY_SECRET=local-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=local-razorpay-webhook
